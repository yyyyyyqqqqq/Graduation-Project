# Out-of-source CMake builds and generated output
/build*/
/cmake-build*/
/CMakeFiles/
/CMakeCache.txt
/Testing/
/CMakeUserPresets.json
# OSV runtime cache when an explicitly selected data root is in the checkout
**/cache/osv-v1/
/compile_commands.json
/cmake_install.cmake
/CTestTestfile.cmake
/build.ninja
/.ninja_*
*.exe
*.dll
*.o
*.obj
*_autogen/

# Qt Creator user-local settings
*.user
*.user.*
/.qtcreator/

# Temporary files and private local configuration
*.tmp
*.log
*~
.env
.env.*
# Public templates must contain only empty values or placeholders
!.env.example
local.ini
secrets.ini
private.json
credentials.json
/config/local.*
/config/private.*

# Runtime SQLite databases and journal/WAL sidecar files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
